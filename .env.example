# Copy to .env and fill in. .env is gitignored and must never be committed.

# Shared secret Claude sends as: Authorization: Bearer <token>
# Generate with: openssl rand -hex 32
COMBINE_BEARER_TOKEN=

# Your draft slot per league. Used by 'combine try plan'.
RCL_DRAFT_POS=1
DMWD_DRAFT_POS=
WORK_DRAFT_POS=

SEASON=2026

# --- ESPN (both leagues share one cookie pair) ---
# DevTools > Application > Cookies on fantasy.espn.com. Keep the braces on SWID.
# These expire mid-season. scripts/refresh_espn_cookies.py rewrites them in place.
ESPN_S2=
ESPN_SWID=

ESPN_RCL_ID=          # The REAL Champions League
ESPN_RCL_TEAM_ID=
ESPN_DMWD_ID=         # Dont Mess With Dexas
ESPN_DMWD_TEAM_ID=

# --- Yahoo ---
# From the Yahoo developer portal app registration (Fantasy Sports, read scope).
YAHOO_CONSUMER_KEY=
YAHOO_CONSUMER_SECRET=
YAHOO_LEAGUE_ID=      # work league
YAHOO_TEAM_KEY=

# --- server ---
COMBINE_HOST=127.0.0.1
COMBINE_PORT=8787
COMBINE_PATH=/mcp

# --- discord bot ---
# Token from the Discord developer portal, Bot tab, Reset Token. This is a
# secret: it belongs here and nowhere else, never in chat, code or the docs.
# Anyone holding it controls the bot.
DISCORD_TOKEN=
# Right-click the server and the channel with Developer Mode on, Copy ID.
# The scheduled check posts to this channel; slash commands answer wherever
# they are used.
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
# Your own user ID, also via right-click Copy ID. Commands are refused for
# anyone else: without this, whoever can see the bot can read your rosters and
# drive ESPN requests authenticated as you.
DISCORD_OWNER_ID=

# --- who may open the app ---
# The app has no login of its own on purpose: a login page inside Streamlit
# only runs AFTER the request has reached a process holding live ESPN cookies.
# Authentication belongs at the edge, so the hostname gets a Cloudflare Access
# policy with Google as the login method and your address on the allow list.
#
# These three are the SECOND lock. With them set, the app verifies the signed
# token Access puts on every request it forwards and refuses anything else, so
# it is still safe if it ends up bound to 0.0.0.0 or reached on the LAN.
# Leave them blank on a laptop and the check is skipped, with a warning in the
# sidebar. Neither is a secret.
#
# Zero Trust dashboard -> Settings -> Custom Pages shows your team domain.
COMBINE_ACCESS_TEAM=
# Access -> Applications -> your app -> Overview -> Application Audience (AUD).
COMBINE_ACCESS_AUD=
# Optional, comma separated. The same allow list, written where Cloudflare
# cannot edit it, so widening the policy by accident does not widen the app.
COMBINE_ACCESS_EMAILS=
