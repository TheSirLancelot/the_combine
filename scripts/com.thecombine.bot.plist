<?xml version="1.0" encoding="UTF-8"?>
<!--
  Run the Discord bot as a background agent on the Mac mini.

  Same background QoS as the Streamlit agent, so Plex always wins contention.
  Unlike the app there is nothing to expose: this dials OUT to Discord's gateway
  and holds a websocket, so there is no port, no tunnel and no inbound surface.

  Install:
    cp scripts/com.thecombine.bot.plist ~/Library/LaunchAgents/
    # replace <REPO> and confirm the uv path with `which uv` first: launchd
    # starts with a minimal PATH and will not find uv on its own
    launchctl load -w ~/Library/LaunchAgents/com.thecombine.bot.plist
  Check:  launchctl list | grep thecombine.bot
  Logs:   tail -f <REPO>/logs/bot.err
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.thecombine.bot</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/taskpolicy</string>
    <string>-b</string>
    <string>/bin/sh</string>
    <string>-lc</string>
    <string>cd &lt;REPO&gt; &amp;&amp; exec uv run combine bot</string>
  </array>

  <key>WorkingDirectory</key>
  <string>&lt;REPO&gt;</string>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <!-- Discord drops websockets routinely; discord.py reconnects on its own, but
       if the process dies outright launchd should bring it back. -->
  <key>ThrottleInterval</key>
  <integer>30</integer>

  <key>StandardOutPath</key>
  <string>&lt;REPO&gt;/logs/bot.out</string>
  <key>StandardErrorPath</key>
  <string>&lt;REPO&gt;/logs/bot.err</string>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
